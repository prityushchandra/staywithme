# --- Database (Neon serverless Postgres) ---
# Use the POOLED connection string for the app (ends with -pooler), e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/mybnb?sslmode=require
DATABASE_URL=

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Local: http://localhost:3000  | Vercel: your deployed URL
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (optional for local; required for Google sign-in) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (image storage) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Unsigned upload preset used by the listing image uploader
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=mybnb_listings

# --- Admin ---
# The seeded admin account email (gets isAdmin = true on seed)
ADMIN_EMAIL=admin@mybnb.local
ADMIN_PASSWORD=admin12345

# --- Google Sheets backup (optional) ---
# Mirrors offline bookings, revenue, receipts and staff attendance to a Google
# Sheet. Create a Google Cloud service account, enable the Sheets API, download
# its JSON key, then set these and SHARE the sheet with the service-account email
# (Editor). Leave blank to disable (the app no-ops safely).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the JSON (keep the \n escapes on one line).
GOOGLE_PRIVATE_KEY=
# The spreadsheet id from its URL (…/spreadsheets/d/<THIS>/edit). Add tabs:
# Bookings, Revenue, Receipts, StaffPayroll.
GOOGLE_SHEETS_ID=
